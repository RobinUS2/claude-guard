#!/bin/bash
# claude-guard-vault-gate — PreToolUse Bash hook that opportunistically
# loads token-vault-sourced API keys before handing off to claude-guard.
#
# Behaviour: load ~/.config/claude-guard/keys.env (if present) into the
# environment, then forward stdin to `claude-guard decide` unconditionally.
#
# Earlier versions of this script tried to gate on `token-vault status`
# output (checking whether *any* vault was unlocked) before deciding
# whether to load keys.env or to deny/warn. That was the wrong question:
# the only thing this hook actually needs is the Anthropic/Gemini key for
# claude-guard's own LLM classification tier, and "is some vault unlocked
# somewhere" doesn't answer that — a Standard-tier customer being unlocked
# says nothing about whether the specific key claude-guard needs is
# available, and the status-output format isn't a stable contract to grep
# against (it changed shape once already and silently broke this gate).
#
# The precise question — "can I actually get an Anthropic/Gemini key" —
# is already answered correctly by claude-guard's own
# llm.LookupTokenVaultAnthropic(), which tries the specific candidate
# (vault, secret) pairs directly with its own bounded timeout, independent
# of any other vault's lock state. So this script no longer tries to
# duplicate that check at all. If claude-guard can't find a key, it skips
# its LLM tier and falls through to a manual confirmation prompt for
# anything the deterministic rule tiers don't already resolve — see
# CLAUDE_GUARD_REQUIRE_LLM below if you want that case to deny instead.
#
# Environment overrides:
#   CLAUDE_GUARD_BIN         path to the claude-guard binary (default: claude-guard on PATH)
#   CLAUDE_GUARD_REQUIRE_LLM  "1" makes claude-guard deny (instead of falling through
#                             to a manual prompt) when no Anthropic/Gemini key is
#                             available and nothing else resolved the command. Set on
#                             claude-guard itself, not this wrapper — it already reads
#                             this env var directly (inherited via exec below), so it
#                             can act on the exact same scoped key-lookup result it
#                             uses for real classification. Off by default.
#
# Wire-up in ~/.claude/settings.json:
#   {
#     "hooks": {
#       "PreToolUse": [
#         {
#           "matcher": "Bash",
#           "hooks": [
#             { "type": "command", "command": "/path/to/claude-guard-vault-gate" }
#           ]
#         }
#       ]
#     }
#   }

set -u

input="$(cat)"

CLAUDE_GUARD_BIN="${CLAUDE_GUARD_BIN:-claude-guard}"

# Load keys.env, but only after verifying it is owner-only (not group- or
# world-readable) and owned by the current user. Use strict line-by-line
# parsing instead of `source` to prevent arbitrary code execution from a
# compromised or world-writable file. This is a plain local file, not the
# vault itself — no vault-lock-state check needed to read it.
KEYS_ENV="$HOME/.config/claude-guard/keys.env"
if [ -f "$KEYS_ENV" ]; then
  # stat -f on macOS, stat -c on Linux.
  if stat --version >/dev/null 2>&1; then
    # GNU stat
    owner_uid=$(stat -c '%u' "$KEYS_ENV" 2>/dev/null)
    perms=$(stat -c '%a' "$KEYS_ENV" 2>/dev/null)
  else
    # BSD/macOS stat
    owner_uid=$(stat -f '%u' "$KEYS_ENV" 2>/dev/null)
    perms=$(stat -f '%Lp' "$KEYS_ENV" 2>/dev/null)
  fi
  if [ "$owner_uid" = "$(id -u)" ] && [ "$perms" = "600" ]; then
    # Safe to parse. Read KEY=VALUE lines; skip comments and blanks.
    while IFS='=' read -r key val; do
      case "$key" in
        ''|\#*) continue ;;
      esac
      # Reject keys that are not plain identifiers.
      case "$key" in
        *[!A-Za-z0-9_]*) continue ;;
      esac
      export "$key=$val"
    done < "$KEYS_ENV"
  fi
fi

printf '%s' "$input" | exec "$CLAUDE_GUARD_BIN" decide
